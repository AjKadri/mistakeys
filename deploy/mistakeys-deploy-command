#!/bin/sh
set -eu

original_command=${SSH_ORIGINAL_COMMAND:-}
deployctl=/opt/mistakeys/deploy/deployctl.sh

case "$original_command" in
  rollback)
    exec "$deployctl" rollback
    ;;
  status)
    exec "$deployctl" status
    ;;
esac

case "$original_command" in
  deploy\ *)
    deploy_sha=${original_command#deploy }
    if ! printf '%s\n' "$deploy_sha" | grep -Eq '^[0-9a-fA-F]{40}$'; then
      echo 'unsupported deployment operation' >&2
      exit 64
    fi
    exec "$deployctl" deploy "$deploy_sha"
    ;;
  *)
    echo 'unsupported deployment operation' >&2
    exit 64
    ;;
esac
